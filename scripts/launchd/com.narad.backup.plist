<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Narad nightly encrypted backup at 03:30 (scripts/narad_backup.py backup). If the Mac is asleep then, launchd runs it on wake. Template: see scripts/install_launchd.sh. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.narad.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@ROOT@/scripts/run_job.sh</string>
        <string>@ROOT@/scripts/narad_backup.py</string>
        <string>backup</string>
    </array>
    <key>WorkingDirectory</key>
    <string>@ROOT@</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/backup.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/backup.log</string>
</dict>
</plist>
