<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Narad weekly restore drill, Sundays at 04:30 (scripts/narad_backup.py drill): restores the newest backup into a temporary folder, verifies it and records the result. Template: see scripts/install_launchd.sh. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.narad.drill</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@ROOT@/scripts/run_job.sh</string>
        <string>@ROOT@/scripts/narad_backup.py</string>
        <string>drill</string>
    </array>
    <key>WorkingDirectory</key>
    <string>@ROOT@</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/drill.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/drill.log</string>
</dict>
</plist>
