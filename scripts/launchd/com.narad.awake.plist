<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the host from sleeping while it is on the charger (caffeinate -s holds no assertion on battery). It does not stop sleep when the lid closes; see the pmset advice printed by scripts/install_launchd.sh. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.narad.awake</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-s</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
